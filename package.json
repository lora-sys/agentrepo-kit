{
  "name": "agentrepo-kit",
  "version": "0.7.0",
  "description": "Agent-ready repository CLI, verified docs, architecture checks and replayable evals",
  "type": "module",
  "bin": {
    "agentrepo": "./bin/agentrepo.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "bench": "node benchmarks/run.mjs",
    "replay": "node bin/agentrepo.mjs eval replay --json",
    "check": "node --check bin/agentrepo.mjs && npm test",
    "eval:smoke": "node benchmarks/smoke.mjs"
  },
  "files": [
    "bin",
    "benchmarks",
    "README.md",
    "LICENSE",
    "docs",
    "tests",
    ".github",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "AGENTS.md",
    "examples",
    "scripts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lora-sys/agentrepo-kit.git"
  },
  "homepage": "https://github.com/lora-sys/agentrepo-kit#readme",
  "bugs": {
    "url": "https://github.com/lora-sys/agentrepo-kit/issues"
  },
  "keywords": [
    "coding-agent",
    "agent-friendly",
    "repository-scaffold",
    "cli",
    "eval",
    "architecture",
    "documentation"
  ]
}
